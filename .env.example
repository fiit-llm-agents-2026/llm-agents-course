# Copy to .env and fill in. Keep comments on their own lines: python-dotenv
# keeps a comment written after an EMPTY value as the value itself.

# openai_compat | google_genai
LLM_PROVIDER=openai_compat
# the key of the channel you chose
LLM_API_KEY=
# openai_compat: DeepSeek https://api.deepseek.com, Polza https://polza.ai/api/v1, Cerebras https://api.cerebras.ai/v1
# google_genai: session 1 reads this too, https://generativelanguage.googleapis.com/v1beta/openai/
LLM_BASE_URL=
# empty for Gemini, Cerebras and Polza (Polza: put @reasoning_effort=none in the model id); none for DeepSeek direct and gpt-5.x
LLM_REASONING_EFFORT=

MODEL_CHEAP=
MODEL_STRONG=

# from session 2; leave the three empty before that
LANGFUSE_HOST=
# pk-lf-... invent it; compose creates the project with it
LANGFUSE_PUBLIC_KEY=
# sk-lf-... same
LANGFUSE_SECRET_KEY=
