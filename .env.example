# Copy to .env and fill in. Keep comments on their own lines: python-dotenv
# keeps a comment written after an EMPTY value as the value itself.

# openai_compat | google_genai
LLM_PROVIDER=openai_compat
# the key of the channel you chose
LLM_API_KEY=
# only for openai_compat
LLM_BASE_URL=https://api.cerebras.ai/v1
# leave empty; none for gpt-5.x over chat completions
LLM_REASONING_EFFORT=

MODEL_CHEAP=
MODEL_STRONG=

# from session 2; leave the three empty before that
LANGFUSE_HOST=
# pk-lf-... invent it; compose creates the project with it
LANGFUSE_PUBLIC_KEY=
# sk-lf-... same
LANGFUSE_SECRET_KEY=
