# Copy to .env. Keep secrets out of Git.
LLM_PROVIDER=openai_compat
LLM_API_KEY=
LLM_BASE_URL=https://api.polza.ai/api/v1
MODEL_CHEAP=
LLM_REASONING_EFFORT=
# Generate API_TOKEN and POSTGRES_PASSWORD with the notebook command.
API_TOKEN=
POSTGRES_PASSWORD=
API_PORT=8108
# Used by client.py on your computer, not by the bot container.
API_URL=http://localhost:8108
TELEGRAM_BOT_TOKEN=
# Optional: reuse the project from lesson 2. Leave both keys empty to skip tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000
# From inside Docker: host.docker.internal for local Langfuse, cloud URL for hosted Langfuse.
LANGFUSE_DOCKER_URL=http://host.docker.internal:3000
